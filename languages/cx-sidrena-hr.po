#: includes/class-import.php:106
msgid "I confirm, on behalf of the shop owner, that the brand, EAN and barcode in this file are taken from the product, its packaging or the supplier, and that they may be imported."
msgstr "Potvrđujem u ime vlasnika trgovine da su marka, EAN i barkod u ovoj datoteci preuzeti s proizvoda, njegova pakiranja ili od dobavljača i da se smiju uvesti."

#: includes/class-import.php:109
msgid "I confirm, on behalf of the shop owner, that the prices in this file were the products' prices on the dates given (bazna cijena), that the brand, EAN and barcode are taken from the product, its packaging or the supplier, and that they may be imported."
msgstr "Potvrđujem u ime vlasnika trgovine da su cijene u ovoj datoteci bile cijene proizvoda na navedene datume (bazna cijena), da su marka, EAN i barkod preuzeti s proizvoda, njegova pakiranja ili od dobavljača i da se smiju uvesti."

#: includes/class-import.php:112
msgid "I confirm, on behalf of the shop owner, that the prices in this file were the products' prices on the dates given (bazna cijena), and that they may be imported."
msgstr "Potvrđujem u ime vlasnika trgovine da su cijene u ovoj datoteci bile cijene proizvoda na navedene datume (bazna cijena) i da se smiju uvesti."

#: includes/class-import.php:128
#: includes/class-import.php:188
msgid "The file has no rows."
msgstr "Datoteka nema redaka."

#: includes/class-import.php:133
#: includes/class-import.php:1502
msgid "Upload a CSV file. From Excel: Save as, \"CSV UTF-8\"."
msgstr "Učitajte CSV datoteku. Iz Excela: Spremi kao, „CSV UTF-8”."

#: includes/class-import.php:141
msgid "The first row must name the columns."
msgstr "Prvi redak mora sadržavati nazive stupaca."

#: includes/class-import.php:153
msgid "Column missing: SKU."
msgstr "Nedostaje stupac: SKU."

#: includes/class-import.php:164
msgid "Column missing: Bazna cijena (or Brand, EAN or Barcode)."
msgstr "Nedostaje stupac: Bazna cijena (ili Brand, EAN ili Barcode)."

#: includes/class-import.php:192
#, php-format
msgid "The file has more than %d rows. Split it into smaller files."
msgstr "Datoteka ima više od %d redaka. Podijelite je na manje datoteke."

#: includes/class-import.php:415
#. translators: 1: the amount in the file, 2: the amount the price list would show (both as the price list writes them, e.g. 12,50 €)
#, php-format
msgid "The bazna cijena is not imported: the file has %1$s, but the price list would show %2$s, because your webshop's theme or another plugin changes the amounts it shows. If you don't know what changes them, tell us."
msgstr "Bazna cijena nije uvezena: u datoteci je %1$s, a cjenik bi je pokazao kao %2$s, jer tema ili drugi dodatak na vašoj web trgovini mijenja prikazane iznose. Ako ne znate što ih mijenja, javite nam."

#: includes/class-import.php:524
#. translators: 1: EAN or barcode, 2: the cell as in the file
#, php-format
msgid "The %1$s came as %2$s: Excel turned it into a number and cut it. In Excel set the column to Text, enter the codes again and save as \"CSV UTF-8\"."
msgstr "%1$s je stigao kao %2$s: Excel ga je pretvorio u broj i skratio. U Excelu stupac postavite kao Tekst, ponovno upišite kodove i spremite kao „CSV UTF-8”."

#: includes/class-import.php:525
msgid "barcode"
msgstr "Barkod"

#: includes/class-import.php:537
#, php-format
msgid "The EAN %s must have 8 or 13 digits. Put a code of another length in Barcode."
msgstr "EAN %s mora imati 8 ili 13 znamenki. Kod druge duljine upišite u Barcode."

#: includes/class-import.php:541
#, php-format
msgid "The EAN %s is not valid: its check digit does not match. Check it on the packaging or with the supplier."
msgstr "EAN %s nije ispravan: kontrolna znamenka se ne slaže. Provjerite ga na pakiranju ili kod dobavljača."

#: includes/class-import.php:666
msgid "The row has no SKU (and no ID)."
msgstr "Redak nema SKU (ni ID)."

#: includes/class-import.php:712
#, php-format
msgid "This product is in the file more than once (rows %s)."
msgstr "Ovaj proizvod je u datoteci više puta (retci %s)."

#: includes/class-import.php:722
msgid "Set the bazna cijena per variation (use the variation SKUs)."
msgstr "Baznu cijenu postavite po varijaciji (koristite SKU-ove varijacija)."

#: includes/class-import.php:723
msgid "This is a variable product: import per variation (use the variation SKUs)."
msgstr "Ovo je varijabilni proizvod: uvezite po varijacijama (koristite SKU-ove varijacija)."

#: includes/class-import.php:731
msgid "The bazna cijena must be an amount above zero, e.g. 19,90."
msgstr "Bazna cijena mora biti iznos veći od nule, npr. 19,90."

#: includes/class-import.php:737
msgid "A date needs a bazna cijena in the same row."
msgstr "Datum traži baznu cijenu u istom retku."

#: includes/class-import.php:742
msgid "The date must be a real date, not later than today, e.g. 10.9.2026."
msgstr "Datum mora biti stvaran datum, ne kasniji od današnjeg, npr. 10.9.2026."

#: includes/class-import.php:753
msgid "The lowest price in 30 days must be an amount above zero."
msgstr "Najniža cijena u 30 dana mora biti iznos veći od nule."

#: includes/class-import.php:758
msgid "The lowest price in 30 days is only for a product on sale now."
msgstr "Najniža cijena u 30 dana upisuje se samo za proizvod koji je sada na akciji."

#: includes/class-import.php:1006
msgid "The file could not be kept for the preview. The server's temporary folder is not writable."
msgstr "Datoteka se nije mogla zadržati za pregled. U privremenu mapu poslužitelja ne može se pisati."

#: includes/class-import.php:1074
#: includes/class-import.php:1126
#: includes/class-import.php:1543
msgid "The upload has expired. Upload the file again."
msgstr "Učitavanje je isteklo. Ponovno učitajte datoteku."

#: includes/class-import.php:1077
msgid "The file is not the one in the preview. Upload it again."
msgstr "To nije datoteka iz pregleda. Učitajte je ponovno."

#: includes/class-import.php:1105
msgid "Nothing to import: every row is unchanged, not found or invalid."
msgstr "Nema što uvesti: svaki redak je nepromijenjen, nije pronađen ili nije valjan."

#: includes/class-import.php:1130
msgid "The file could not be kept for the import. The server's temporary folder is not writable."
msgstr "Datoteka se nije mogla zadržati za uvoz. U privremenu mapu poslužitelja ne može se pisati."

#: includes/class-import.php:1233
msgid "The import's rows were removed from the server's temporary folder before it ended. Upload the file again."
msgstr "Retci uvoza obrisani su iz privremene mape poslužitelja prije nego što je uvoz završio. Ponovno učitajte datoteku."

#: includes/class-import.php:1279
#: includes/class-import.php:1305
#: includes/class-import.php:1317
#: includes/class-import.php:1324
msgid "Changed since the preview."
msgstr "Promijenjeno nakon pregleda."

#: includes/class-import.php:1313
msgid "The product was deleted or moved to the trash since the preview."
msgstr "Proizvod je obrisan ili premješten u smeće nakon pregleda."

#: includes/class-import.php:1327
