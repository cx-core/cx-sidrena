msgstr "Upišite vrstu, npr. prodavaonica. Ulazi u službeni naziv datoteke cjenika ovog mjesta."

#: includes/class-admin.php:1116
#. translators: %s: the label as it would be saved
#, php-format
msgid "The webshop already has the label %s. Enter another one, or leave the field empty for the next free number."
msgstr "Oznaku %s već ima webshop. Upišite drugu ili ostavite polje prazno za sljedeći slobodni broj."

#: includes/class-admin.php:1117
#. translators: 1: the label as it would be saved, 2: the name of the outlet that has it
#, php-format
msgid "The outlet %2$s already has the label %1$s. Enter another one, or leave the field empty for the next free number."
msgstr "Oznaku %1$s već ima prodajno mjesto %2$s. Upišite drugu ili ostavite polje prazno za sljedeći slobodni broj."

#: includes/class-admin.php:1118
#. translators: %s: the label as it would be saved
#, php-format
msgid "Another outlet already has the label %s. Enter another one, or leave the field empty for the next free number."
msgstr "Oznaku %s već ima drugo prodajno mjesto. Upišite drugu ili ostavite polje prazno za sljedeći slobodni broj."

#: includes/class-admin.php:1119
msgid "Choose at least one product, or All published webshop products."
msgstr "Odaberite barem jedan proizvod ili „Svi objavljeni proizvodi webshopa”."

#: includes/class-admin.php:1121
msgid "The outlets are not saved. The reason is next to the outlet below."
msgstr "Prodajna mjesta nisu spremljena. Razlog piše uz prodajno mjesto ispod."

#: includes/class-admin.php:1122
#. translators: %s: the reason
#, php-format
msgid "The outlets are not saved, so you see the state before your changes. Reason: %s"
msgstr "Prodajna mjesta nisu spremljena, pa ovdje vidite stanje prije izmjene. Razlog: %s"

#: includes/class-admin.php:1124
msgid "An outlet without an address can't be saved, because the address goes into the official name of its price list file."
msgstr "Prodajno mjesto bez adrese ne može se spremiti, jer adresa ulazi u službeni naziv datoteke cjenika."

#: includes/class-admin.php:1125
msgid "An outlet without a type can't be saved, because the type goes into the official name of its price list file."
msgstr "Prodajno mjesto bez vrste ne može se spremiti, jer vrsta ulazi u službeni naziv datoteke cjenika."

#: includes/class-admin.php:1126
msgid "The webshop or another outlet already has the label you entered, or the outlet has published a price list in the meantime, so its label no longer changes."
msgstr "Upisanu oznaku već ima webshop ili drugo prodajno mjesto, ili je mjesto u međuvremenu objavilo cjenik, pa se njegova oznaka više ne mijenja."

#: includes/class-admin.php:1128
#. translators: 1: the label as it would be saved, 2: the name of the outlet that has it
#, php-format
msgid "The outlet %2$s already has the label %1$s. Enter another label for the webshop: the address of the webshop's price list has no label, so it stays the same."
msgstr "Oznaku %1$s već ima prodajno mjesto %2$s. Upišite webshopu drugu oznaku: adresa cjenika webshopa nema oznaku, pa ostaje ista."

#: includes/class-admin.php:1129
#. translators: %s: the label as it would be saved
#, php-format
msgid "Another outlet already has the label %s. Enter another label for the webshop: the address of the webshop's price list has no label, so it stays the same."
msgstr "Oznaku %s već ima drugo prodajno mjesto. Upišite webshopu drugu oznaku: adresa cjenika webshopa nema oznaku, pa ostaje ista."

#: includes/class-admin.php:1130
msgid "An empty field means the label 001."
msgstr "Prazno polje znači oznaku 001."

#: includes/class-admin.php:1131
msgid "The outlets are not saved. The reason is next to the marked fields below."
msgstr "Prodajna mjesta nisu spremljena. Razlog piše uz označena polja ispod."

#: includes/class-admin.php:1132
msgid "The label you entered for the webshop is already the label of an outlet."
msgstr "Oznaku koju ste upisali za webshop već ima prodajno mjesto."

#: includes/class-admin.php:1134
msgid "The outlets are not saved, because the page did not confirm that it had loaded all outlets, and saving could have deleted the ones it did not show. Your saved outlets have not changed. Refresh the page and make your changes again."
msgstr "Prodajna mjesta nisu spremljena, jer stranica nije potvrdila da je učitala sva mjesta, a spremanje bi moglo obrisati ona koja nije prikazala. Spremljena mjesta nisu promijenjena. Osvježite stranicu i ponovite izmjene."

#: includes/class-admin.php:1137
#, php-format
msgid "Not saved: %s has its own price list, so the same price list for all places of sale can't be turned on. Turn it off and save again."
msgstr "Nije spremljeno: %s ima svoj cjenik, pa se isti cjenik za sva prodajna mjesta ne može uključiti. Isključite ga i spremite ponovno."

#: includes/class-admin.php:1138
msgid "The outlets are not saved, because they were also being saved somewhere else at the same moment, for example in another browser tab. Your changes are still here. Click Save outlets again."
msgstr "Prodajna mjesta nisu spremljena jer su se u istom trenutku spremala i drugdje, npr. u drugoj kartici preglednika. Vaše izmjene su još ovdje. Kliknite ponovno „Spremi prodajna mjesta”."

#: includes/class-admin.php:1139
msgid "Search product…"
msgstr "Traži proizvod…"

#: includes/class-admin.php:1140
msgid "First add products on the Products tab."
msgstr "Prvo dodajte proizvode u kartici Proizvodi."

#: includes/class-admin.php:1141
#: includes/class-bulk-import.php:646
msgid "Select the outlet to import into."
msgstr "Odaberite poslovnicu u koju se uvozi."

#: includes/class-admin.php:1142
msgid "Remove outlet"
msgstr "Ukloni prodajno mjesto"

#: includes/class-admin.php:1284
msgid "The webshop's price list of services that are not products in WooCommerce, for example fitting or engraving."
msgstr "Cjenik usluga web trgovine koje nisu proizvodi u WooCommerceu, na primjer montaža ili graviranje."

#: includes/class-admin.php:1286
#, php-format
msgid "%1$s (%2$s)"
msgstr "%1$s (%2$s)"

#: includes/class-admin.php:1287
msgid "This place has no imported price list yet."
msgstr "Ovo mjesto još nema uvezeni cjenik."

#: includes/class-admin.php:1289
#, php-format
msgid "This place's price list was imported on %1$s (items: %2$d). A new import replaces it."
msgstr "Cjenik ovog mjesta uvezen je %1$s (stavki: %2$d). Novi uvoz ga zamjenjuje."

#: includes/class-admin.php:1291
#, php-format
msgid "The webshop's price list has services: %d. A new import replaces them."
msgstr "U cjeniku web trgovine je usluga: %d. Novi uvoz ih zamjenjuje."

#: includes/class-admin.php:1292
msgid "Price list for"
msgstr "Cjenik za"

#: includes/class-admin.php:1293
msgid "Webshop (services only)"
msgstr "Web trgovina (samo usluge)"

#: includes/class-admin.php:1294
msgid "Leave this import? Nothing has been written yet."
msgstr "Napustiti ovaj uvoz? Ništa još nije upisano."

#: includes/class-admin.php:1296
msgid "Columns"
msgstr "Stupci"

#: includes/class-admin.php:1299
msgid "You have no place of sale yet. For a shop's price list, add one in Settings, under Places of sale."
msgstr "Još nemate prodajno mjesto. Za cjenik dućana dodajte ga u Postavkama, pod Prodajna mjesta."

#: includes/class-admin.php:1300
msgid "Open Places of sale"
msgstr "Otvori Prodajna mjesta"

#: includes/class-admin.php:1301
msgid "The same price list for all places of sale is turned on, so no place has its own price list. If this place has its own prices, turn it off in Settings, under Places of sale."
msgstr "Uključen je isti cjenik za sva prodajna mjesta, pa nijedno mjesto nema svoj cjenik. Ako ovo mjesto ima svoje cijene, isključite ga u Postavkama, pod Prodajna mjesta."

#: includes/class-admin.php:1303
msgid "There are no rows in the file."
msgstr "U datoteci nema redaka."

#: includes/class-admin.php:1304
#: includes/class-bulk-import.php:185
msgid "Letters such as č, ć and ž can't be read in this file. Save it as CSV UTF-8 and upload it again."
msgstr "Slova poput č, ć i ž u ovoj se datoteci ne čitaju. Spremite je kao CSV UTF-8 i učitajte ponovno."

#: includes/class-admin.php:1307
msgid "Which column is which?"
msgstr "Koji stupac je što?"

#: includes/class-admin.php:1308
msgid "We picked them from the column names. Check them, then go on."
msgstr "Odabrali smo ih prema nazivima stupaca. Provjerite ih, pa nastavite."

#: includes/class-admin.php:1309
msgid "— not imported —"
msgstr "— ne uvozi se —"

#: includes/class-admin.php:1311
#, php-format
msgid "e.g. %s"
msgstr "npr. %s"

#: includes/class-admin.php:1312
msgid "required"
msgstr "obavezno"

#: includes/class-admin.php:1313
msgid "SKU or row ID required"
msgstr "obavezna šifra ili ID retka"

#: includes/class-admin.php:1314
msgid "More columns"
msgstr "Više stupaca"

#: includes/class-admin.php:1315
msgid "Row ID (d1, d2 …)"
msgstr "ID retka (d1, d2 …)"

#: includes/class-admin.php:1317
#, php-format
msgid "Goods: %1$d · Services: %2$d"
msgstr "Roba: %1$d · Usluge: %2$d"

#: includes/class-admin.php:1318
msgid "Without a Type column every row is goods."
msgstr "Bez stupca Vrsta svi retci su roba."

#: includes/class-admin.php:1319
msgid "Every row is imported as a service, except those marked as goods in the Type column."
msgstr "Svi retci uvoze se kao usluge, osim onih kojima u stupcu Vrsta piše roba."

#: includes/class-admin.php:1321
msgid "Next step"
msgstr "Dalje"

#: includes/class-admin.php:1322
msgid "Choose a column for Name, for Regular price, and for SKU or Row ID."
msgstr "Odaberite stupac za Naziv, za Redovnu cijenu te za Šifru ili ID retka."

#: includes/class-admin.php:1323
msgid "Back"
msgstr "Natrag"

#: includes/class-admin.php:1325
#, php-format
msgid "%1$s · rows: %2$d"
msgstr "%1$s · redaka: %2$d"

#: includes/class-admin.php:1326
msgid "Changed"
msgstr "Promijenjeno"

#: includes/class-admin.php:1327
msgid "Waits"
msgstr "Čeka"

#: includes/class-admin.php:1328
msgid "Won't be imported"
msgstr "Neće se uvesti"

#: includes/class-admin.php:1329
msgid "Price"
msgstr "Cijena"

#: includes/class-admin.php:1330
msgid "Only the webshop's services are imported here. Goods from WooCommerce have their own import (Bazna cijene of products); goods in Additional items are edited there."
msgstr "Ovdje se uvoze samo usluge web trgovine. Roba iz WooCommercea ima svoj uvoz (Bazne cijene proizvoda), a roba iz Dodatnih stavki uređuje se ondje."

#: includes/class-admin.php:1331
msgid "No name."
msgstr "Nema naziva."

#: includes/class-admin.php:1332
msgid "No price."
msgstr "Nema cijene."

#: includes/class-admin.php:1334
#, php-format
msgid "The amount is not clear: %s"
msgstr "Iznos nije jasan: %s"

#: includes/class-admin.php:1335
msgid "goods"
msgstr "roba"

#: includes/class-admin.php:1336
msgid "service"
msgstr "usluga"

#: includes/class-admin.php:1338
#, php-format
msgid "%s (default)"
msgstr "%s (zadano)"

#: includes/class-admin.php:1339
msgid "A service without a date or bazna cijena: saved, but not in the price list until it has both."
msgstr "Usluga bez datuma ili bazne cijene: sprema se, ali nije u cjeniku dok ne dobije oboje."

#: includes/class-admin.php:1341
#, php-format
msgid "Belongs to another place of sale (%s)."
msgstr "Pripada drugom prodajnom mjestu (%s)."

#: includes/class-admin.php:1342
msgid "No SKU or row ID: without it, every new import would add this row again."
msgstr "Nema šifre ni ID-a retka: bez njih bi ga svaki novi uvoz dodao još jednom."

#: includes/class-admin.php:1344
#, php-format
msgid "The same SKU or row ID as row %d. Only that row is imported."
msgstr "Ista šifra ili ID retka kao u retku %d. Uvozi se samo taj redak."

#: includes/class-admin.php:1345
msgid "The price is a special form of sale (DA), but the row has no name of that form, so it is not known which price it is. If the file has a column with that name, choose it under More columns."
msgstr "Cijena je iz posebnog oblika prodaje (DA), a redak nema naziv tog oblika, pa se ne zna koja je to cijena. Ako datoteka ima stupac s tim nazivom, odaberite ga pod Više stupaca."

#: includes/class-admin.php:1346
msgid "Goods without a bazna cijena are not imported. Add the bazna cijena and its date to the file."
msgstr "Roba bez bazne cijene ne uvozi se. U datoteku dodajte baznu cijenu i njezin datum."

#: includes/class-admin.php:1347
msgid "Will be removed"
msgstr "Uklanja se"

#: includes/class-admin.php:1349
#, php-format
msgid "Items removed from the price list: %d. The list is in the preview, under Will be removed."
msgstr "Iz cjenika se uklanja stavki: %d. Popis je u pregledu, pod Uklanja se."

#: includes/class-admin.php:1350
msgid "Not in this file."
msgstr "Nema je u ovoj datoteci."

#: includes/class-admin.php:1351
#: includes/class-bulk-import.php:2298
msgid "No row in this file can be imported. The reasons are in the table."
msgstr "Nijedan redak iz ove datoteke ne može se uvesti. Razlozi su u tablici."

#: includes/class-admin.php:1352
msgid "This file is not imported: none of its rows would go into the price list, so the waiting services are not saved either. Add their date and bazna cijena to the file, then upload it again."
msgstr "Ova se datoteka ne uvozi: nijedan njezin redak ne bi ušao u cjenik, pa se ne spremaju ni usluge koje čekaju. U datoteku im dodajte datum i baznu cijenu, pa je učitajte ponovno."

#: includes/class-admin.php:1353
#: includes/class-bulk-import.php:2311
msgid "The price list changed after the preview, so nothing was written. Upload the file again."
msgstr "Cjenik se promijenio nakon pregleda, pa ništa nije upisano. Učitajte datoteku ponovno."

#: includes/class-admin.php:1354
#: includes/class-bulk-import.php:2312
msgid "The places of sale changed after the preview, so nothing was written. Upload the file again."
msgstr "Prodajna mjesta su se promijenila nakon pregleda, pa ništa nije upisano. Učitajte datoteku ponovno."

#: includes/class-admin.php:1355
msgid "The import could not be saved, so nothing was written. Upload the file again. If it happens again, tell us."
msgstr "Uvoz se nije mogao spremiti, pa ništa nije upisano. Učitajte datoteku ponovno. Ako se ponovi, javite nam."

#: includes/class-admin.php:1357
#, php-format
msgid "Imported into the price list of %1$s: %2$d (goods %3$d, services %4$d)."
msgstr "Upisano u cjenik mjesta %1$s: %2$d (roba %3$d, usluge %4$d)."

#: includes/class-admin.php:1359
#, php-format
msgid "Removed from the price list: %d."
msgstr "Uklonjeno iz cjenika: %d."

#: includes/class-admin.php:1361
#, php-format
msgid "%s now shows only the items from the file. You can give it the webshop's products back in Settings, under Places of sale."
msgstr "Mjesto %s sad pokazuje samo stavke iz datoteke. Proizvode web trgovine možete mu vratiti u Postavkama, pod Prodajna mjesta."

#: includes/class-admin.php:1363
#, php-format
msgid "Imported into the webshop's price list of services: %d."
msgstr "Upisano u cjenik usluga web trgovine: %d."

#: includes/class-admin.php:1365
#, php-format
msgid "Services waiting for a date or bazna cijena: %d. They are not in the price list until they have both: import a file with them, or enter them in Settings, under Additional items."
msgstr "Usluge koje čekaju datum ili baznu cijenu: %d. Nisu u cjeniku dok ne dobiju oboje: uvezite datoteku s njima ili ih upišite u Postavkama, pod Dodatne stavke."

#: includes/class-admin.php:1366
msgid "The price list is published within a few minutes."
msgstr "Cjenik se objavljuje za nekoliko minuta."

#: includes/class-admin.php:1368
#, php-format
msgid "%1$d of %2$d rows"
msgstr "%1$d od %2$d redaka"

#: includes/class-admin.php:1369
msgid "Keep this page open while the file is read. Nothing has been written yet."
msgstr "Ne zatvarajte stranicu dok čitanje traje. Još ništa nije upisano."

#: includes/class-admin.php:1370
msgid "Bazna cijene (webshop)"
msgstr "Bazne cijene (web)"

#: includes/class-admin.php:1372
#, php-format
msgid "Price list: %s"
msgstr "Cjenik: %s"

#: includes/class-admin.php:1373
msgid "Services (webshop)"
msgstr "Usluge (web)"

#: includes/class-admin.php:1375
#, php-format
msgid "%1$s shows the webshop's products (%2$d)."
msgstr "Mjesto %1$s pokazuje proizvode web trgovine (%2$d)."

#: includes/class-admin.php:1377
#, php-format
msgid "This place shows %d webshop products today. After the import it will show only the items from this file. You can give it the webshop's products back in Settings, under Places of sale."
msgstr "Ovo mjesto danas pokazuje proizvoda web trgovine: %d. Nakon uvoza pokazivat će samo stavke iz ove datoteke. Proizvode web trgovine možete mu vratiti u Postavkama, pod Prodajna mjesta."

#: includes/class-admin.php:1379
#, php-format
msgid "When you confirm, %1$s stops showing the webshop's products (%2$d) and shows only the items from this file."
msgstr "Potvrdom mjesto %1$s prestaje pokazivati proizvode web trgovine (%2$d) i pokazuje samo stavke iz ove datoteke."

#: includes/class-admin.php:1382
#, php-format
msgid "%s is set to show the webshop's products."
msgstr "Mjesto %s je postavljeno da pokazuje proizvode web trgovine."

#: includes/class-admin.php:1383
msgid "This place is set to show the webshop's products. After the import it will show only the items from this file. You can give it the webshop's products back in Settings, under Places of sale."
msgstr "Ovo mjesto je postavljeno da pokazuje proizvode web trgovine. Nakon uvoza pokazivat će samo stavke iz ove datoteke. Proizvode web trgovine možete mu vratiti u Postavkama, pod Prodajna mjesta."

#: includes/class-admin.php:1385
#, php-format
msgid "When you confirm, %s stops showing the webshop's products and shows only the items from this file."
msgstr "Potvrdom mjesto %s prestaje pokazivati proizvode web trgovine i pokazuje samo stavke iz ove datoteke."

#: includes/class-admin.php:1387
msgid "Select Excel, CSV or XML"
msgstr "Odaberite Excel, CSV ili XML"

#: includes/class-admin.php:1388
msgid "Upload the export from your till as it is: Excel, CSV or XML. You choose the columns in the next step."
msgstr "Učitajte izvoz iz blagajne kakav jest: Excel, CSV ili XML. Stupce odabirete u idućem koraku."

#: includes/class-admin.php:1389
#: includes/class-bulk-import.php:1461
msgid "This Excel file can't be read. Open it in Excel, save it as CSV UTF-8 and upload that file."
msgstr "Ova Excelova datoteka ne može se pročitati. Otvorite je u Excelu, spremite kao CSV UTF-8 i učitajte tu datoteku."

#: includes/class-admin.php:1390
#: includes/class-bulk-import.php:1455
msgid "This is an OpenDocument (.ods) file, which can't be read here. Save it as Excel (.xlsx) or CSV and upload that file."
msgstr "Ovo je datoteka OpenDocument (.ods), a ona se ovdje ne čita. Spremite je kao Excel (.xlsx) ili CSV i učitajte tu datoteku."

#: includes/class-admin.php:1391
#: includes/class-bulk-import.php:1458
msgid "Upload an Excel, CSV or XML file."
msgstr "Učitajte datoteku u obliku Excel, CSV ili XML."

#: includes/class-admin.php:1392
msgid "We couldn't tell the columns from their names. Choose each one by the examples in its list."
msgstr "Stupce nismo prepoznali po nazivima. Odaberite svaki po primjerima u njegovu izborniku."

#: includes/class-admin.php:1393
msgid "The columns are set as in the last import of this price list. Check them, then go on."
msgstr "Stupci su postavljeni kao kod zadnjeg uvoza ovog cjenika. Provjerite ih, pa nastavite."

#: includes/class-admin.php:1394
msgid "This file doesn't have the same columns as the last import of this price list, so we picked them again. Check them, then go on."
msgstr "Ova datoteka nema iste stupce kao zadnji uvoz ovog cjenika, pa smo ih odabrali iznova. Provjerite ih, pa nastavite."

#: includes/class-admin.php:1395
msgid "Column names"
msgstr "Nazivi stupaca"

#: includes/class-admin.php:1397
#, php-format
msgid "in row %1$d: %2$s"
msgstr "u retku %1$d: %2$s"

#: includes/class-admin.php:1398
msgid "the file has none"
msgstr "datoteka ih nema"

#: includes/class-admin.php:1399
msgid "The rows above the names are skipped and not saved."
msgstr "Retci iznad naziva preskaču se i ne spremaju se."

#: includes/class-admin.php:1401
#, php-format
msgid "Column %d"
msgstr "Stupac %d"

#: includes/class-admin.php:1403
#, php-format
msgid "%1$s · e.g. %2$s"
msgstr "%1$s · npr. %2$s"

#: includes/class-admin.php:1404
msgid "Start of the file"
msgstr "Početak datoteke"

#: includes/class-admin.php:1406
msgid "is skipped"
msgstr "preskače se"

#: includes/class-admin.php:1407
msgid "column names"
msgstr "nazivi stupaca"

#: includes/class-admin.php:1408
msgid "group heading"
msgstr "naslov skupine"

#: includes/class-admin.php:1410
#, php-format
msgid "Only the first sheet is read: %s."
msgstr "Čita se samo prvi list: %s."

#: includes/class-admin.php:1412
#, php-format
msgid "Without a Type column, the items under the heading “%s” are services and the others are goods."
msgstr "Bez stupca Vrsta stavke ispod naslova „%s” su usluge, a ostale su roba."

#: includes/class-admin.php:1414
#, php-format
msgid "Without a Type column, the items under the heading “%s” are services. The others are goods and are not imported here."
msgstr "Bez stupca Vrsta stavke ispod naslova „%s” su usluge. Ostale su roba i ovdje se ne uvoze."

#: includes/class-admin.php:1415
msgid "Without a bazna cijena, goods are not imported. If the bazna cijena is the same as the price, choose the same column as for Regular price."
msgstr "Bez bazne cijene roba se ne uvozi. Ako je bazna cijena ista kao cijena, odaberite isti stupac kao za Redovnu cijenu."

#: includes/class-admin.php:1416
msgid "Without a bazna cijena, new items take their price as the bazna cijena."
msgstr "Bez bazne cijene nove stavke dobivaju cijenu kao baznu."

#: includes/class-admin.php:1418
msgid "Without a bazna cijena, new goods with a date in the file are not imported. New items without a date take their price as the bazna cijena and today's date."
msgstr "Bez bazne cijene nova roba s datumom u datoteci ne uvozi se. Nove stavke bez datuma dobivaju cijenu kao baznu i današnji datum."

#: includes/class-admin.php:1420
#, php-format
msgid "Without a date column, services wait for their date, and goods take the default date from Settings: %s."
msgstr "Bez stupca datuma usluge čekaju svoj datum, a roba dobiva zadani datum iz Postavki: %s."

#: includes/class-admin.php:1421
msgid "Without a date column, new items are dated today."
msgstr "Bez stupca datuma nove stavke dobivaju današnji datum."

